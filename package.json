  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/mdx": "^2.0.13",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3"
